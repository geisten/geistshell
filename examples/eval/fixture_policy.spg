(policy
 (network_default deny)
 (budgets
  (inference_steps 8) (tokens 256) (shell_actions 4) (sim_actions 8)
  (memory_actions 8) (wall_ms 10000) (journal_bytes 1048576) (risk_bp 10000))
 (capability
  ((name sim.act) (kind simulator) (enabled true) (budget 8))
  ((name build.run) (kind local_shell) (enabled true) (budget 4))
  ((name mem.rw) (kind memory) (enabled true) (budget 8))))
