; The world after batch_job was paused: load has dropped and critical_app has
; the machine back. This is what the tick following the action must observe —
; if the agent still saw loop_before it would pause again forever.
(machine-state (cpu-load-bp 1500) (load-1-cbp 60)
 (memory-total-bytes 4245815296) (memory-used-bytes 1150000000)
 (swap-used-bytes 0) (temperature-mc 58000) (cpu-freq-khz 1500000)
 (throttle none) (process-count 42)
 (process (id "critical_app") (role critical) (cpu-bp 1200) (rss-bytes 52428800))
 (process (id "batch_job") (role batch) (cpu-bp 0) (rss-bytes 104857600)))
