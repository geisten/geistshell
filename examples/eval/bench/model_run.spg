(run
 (model "gguf_artifacts/gemma4-e2b-Q4_K_M.gguf")
 (policy "examples/eval/bench/model_policy.spg")
 (scenario "examples/scenario.spg")
 (corpus "examples/corpus.spg")
 (journal "build/eval/bench.sgj")
 (seed 42)
 (budgets
  (inference_steps 8) (tokens 512) (shell_actions 4) (sim_actions 8)
  (memory_actions 8) (wall_ms 120000) (journal_bytes 1048576) (risk_bp 10000)))
