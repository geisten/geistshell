;; Real-model baseline suite. Seed for geistshell#53, which grows this to the
;; full 7+7 train/hold-out set with the parse/gate/task ladder. Run via
;; `make bench` — never `make test`, which must not need a GGUF.
(eval_suite
 (config "examples/eval/bench/model_run.spg")
 ;; shell-count: the answer is a property of the fixture, so a pass means the
 ;; model chose local_shell AND produced a command that actually works.
 (case (name "shell-count") (model "geist")
       (fixture "examples/eval/fixtures/workdir") (allow_exec true) (max_steps 4)
       (expect (termination finished) (observation "7")))
 ;; mem-recall: the answer is in the seeded mind-palace. A weak model reaches
 ;; for the shell instead — that reflex is the thing being measured.
 (case (name "mem-recall") (model "geist")
       (fixture "examples/eval/fixtures/memory") (max_steps 4)
       (expect (termination finished) (observation "8443"))))
