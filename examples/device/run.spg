; Run config for a plant agent: the plant policy (device and nothing else), and
; a journal of its own so a device run never overwrites another freeze journal.
(run
 (model "fake.gguf")
 (policy "examples/plant-policy.spg")
 (scenario "examples/scenario.spg")
 (corpus "examples/corpus.spg")
 (journal "build/device-demo.sgj")
 (seed 42)
 (budgets
  (inference_steps 8)
  (tokens 256)
  (shell_actions 0)
  (sim_actions 0)
  (memory_actions 0)
  (wall_ms 10000)
  (machine_actions 4)))